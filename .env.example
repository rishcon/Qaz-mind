# QazMind monorepo: reference for every variable. Vite reads apps/web/.env.local and apps/admin/.env.local,
# the backend reads apps/api/.env. Copy only what you need. Never commit real values (.env* is ignored).

# ----- QazMind Web (apps/web) -------------------------------------------------
VITE_API_BASE_URL=
VITE_WEB_URL=http://localhost:5173
VITE_ADMIN_URL=http://localhost:5174
VITE_DEMO_MODE=false

# ----- QazMind Admin (apps/admin) ---------------------------------------------
VITE_ADMIN_DEMO_MODE=

# ----- FastAPI backend (apps/api) ---------------------------------------------
APP_ENV=local
DATABASE_URL=postgresql+asyncpg://qazmind:qazmind@localhost:55432/qazmind
TEST_DATABASE_URL=postgresql+asyncpg://qazmind:qazmind@localhost:55432/qazmind_test
PUBLIC_APP_URL=http://localhost:5173
API_CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]
COOKIE_SECURE=false
MAIL_MODE=smtp
MAIL_FROM=QazMind <noreply@qazmind.local>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_STARTTLS=false
# Production only: SMTP_USERNAME, SMTP_PASSWORD (secrets, never in git), SMTP_STARTTLS=true, COOKIE_SECURE=true.
