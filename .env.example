# Frontend (Vite) configuration. Only public values belong here: the browser bundle is public.
# Base URL of the FastAPI backend. Leave empty to use the Vite dev proxy at /api -> http://localhost:8000.
VITE_API_BASE_URL=

# Set to "true" ONLY for local demonstrations of the prototype school/teacher/admin screens.
# These screens still use browser-only demo data (see docs/audit/stage-0.md). Must stay unset in production.
VITE_DEMO_MODE=false
