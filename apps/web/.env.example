# QazMind Web (Vite). Copy to apps/web/.env.local. Only public values: the browser bundle is public.

# Full API prefix. Empty = /api/v1 on the same origin (the Vite dev proxy forwards it to the backend).
VITE_API_BASE_URL=

# Where the links of this app and of QazMind Admin point to.
VITE_WEB_URL=http://localhost:5173
VITE_ADMIN_URL=http://localhost:5174

# "true" shows the prototype school and admin entry points. Never set it on a public host.
VITE_DEMO_MODE=false
