# Backend configuration. Copy to apps/api/.env for local development. Never commit real values.

APP_ENV=local
DATABASE_URL=postgresql+asyncpg://qazmind:qazmind@localhost:55432/qazmind

# Test database: must be a separate, disposable database. The test run drops and recreates its schema.
TEST_DATABASE_URL=postgresql+asyncpg://qazmind:qazmind@localhost:55432/qazmind_test

PUBLIC_APP_URL=http://localhost:5173
API_CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

SESSION_TTL_DAYS=14
COOKIE_SECURE=false

# Email. Local development uses Mailpit from docker-compose.yml (web UI: http://localhost:8025).
# dev_log only writes emails to the log and is for tests; staging and production must use smtp with a real provider.
MAIL_MODE=smtp
MAIL_FROM=QazMind <noreply@qazmind.local>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_STARTTLS=false
# Real providers: set SMTP_USERNAME and SMTP_PASSWORD (never commit them), and SMTP_STARTTLS=true.
