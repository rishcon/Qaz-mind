# QazMind Admin (Vite). Copy to apps/admin/.env.local. Only public values: the browser bundle is public.

# Empty in development: demo mode is on and marked on screen. Set "false" to see the access gate.
# In production builds demo mode is off unless "true" is set. Never set "true" on a public host.
VITE_ADMIN_DEMO_MODE=

VITE_WEB_URL=http://localhost:5173
VITE_ADMIN_URL=http://localhost:5174
