# Backend configuration. Copy to backend/.env for local development. Never commit real values.

APP_ENV=local
DATABASE_URL=postgresql+asyncpg://qazmind:qazmind@localhost:5432/qazmind

# Test database: must be a separate, disposable database. The test run drops and recreates its schema.
TEST_DATABASE_URL=postgresql+asyncpg://qazmind:qazmind@localhost:5432/qazmind_test

PUBLIC_APP_URL=http://localhost:3000
API_CORS_ORIGINS=["http://localhost:3000"]

SESSION_TTL_DAYS=14
COOKIE_SECURE=false

# Local development only: emails are written to the server log and NOT delivered.
# Staging and production refuse to start with this value until a real mail adapter exists.
MAIL_MODE=dev_log
